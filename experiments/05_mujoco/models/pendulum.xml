<mujoco model="simple_pendulum">
    <option
        timestep="0.002"
        gravity="0 0 -9.81"
    />

    <worldbody>
        <light
            pos="0 0 3"
            dir="0 0 -1"
        />

        <geom
            name="floor"
            type="plane"
            size="2 2 0.1"
            rgba="0.8 0.8 0.8 1"
        />

        <body
            name="pendulum"
            pos="0 0 1.3"
        >
            <joint
                name="hinge"
                type="hinge"
                axis="0 1 0"
                damping="0.1"
            />

            <geom
                name="rod"
                type="capsule"
                fromto="0 0 0 0 0 -1"
                size="0.05"
                density="500"
                rgba="0.2 0.5 0.9 1"
            />
        </body>
    </worldbody>

    <actuator>
        <motor
            name="hinge_motor"
            joint="hinge"
            gear="10"
            ctrllimited="true"
            ctrlrange="-1 1"
        />
    </actuator>

    <sensor>
        <jointpos
            name="hinge_position"
            joint="hinge"
        />

        <jointvel
            name="hinge_velocity"
            joint="hinge"
        />
    </sensor>
</mujoco>